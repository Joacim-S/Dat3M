grammar LitmusAmd;

main
    :   (line? Newline)* line? EOF
    ;

line
    :   directiveLine
    |   instructionLine
    ;

directiveLine
    :   Num scope scopeId
    |   Num Check (Sat | Unsat) alloyCode?
    |   Num Assert
    |   Num Push alloyCode
    |   Num Pop N?
    ;

alloyCode
    : ~Newline+
    ;

instructionLine
    :   (Dollar Name Colon)? memop attributes? addr=~(Newline)
    |   (Dollar Name Colon)? Fence attributes?
    ;

memop
    :   Load
    |   Store
    |   Rmv
    ;

scope
    :   Agent
    |   Cluster
    |   Workgroup
    |   Wave
    |   Thread
    ;

attributes
    :   Dot mem_order (Dot syncscope)?
    |   Dot syncscope Dot mem_order
    ;

syncscope
    :   'ss=' scope
    ;


mem_order
    :   Unordered
    |   Monotonic
    |   Acquire
    |   Release
    |   Acq_rel
    |   Seq_cst
    ;

scopeId
    :   Name
    |   ScopeIdToken
    |   N
    ;

Unordered   : 'unordered';
Monotonic   : 'monotonic';
Acquire     : 'acquire';
Release     : 'release';
Acq_rel     : 'acq_rel';
Seq_cst     : 'seq_cst';

Comment
    :   Slash{2} ~[\r\n]* -> skip
    ;

Unsat   :   'unsat';
Sat     :   'sat';

Newline :   '\n';
Num     :   '#';
Dollar  :   '$';
Colon   :   ':';
Slash   :   '/';
Dot     :   '.';

Check   :   'check';
Assert  :   'assert';
Push    :   'push';
Pop     :   'pop';

Fence   :   'fence';
Rmv     :   'rmw';
Load    :   'load';
Store   :   'store';

Agent       :   'agent'     | 'ag';
Cluster     :   'cluster'   | 'cl';
Workgroup   :   'workgroup' | 'wg';
Wave        :   'wave'      | 'wf';
Thread      :   'thread'    | 'st' | 'singlethread';

Whitespace
    :   [ \t]+
        -> skip
    ;

N   : [0-9]+;

Name
    :   [A-Za-z][A-Za-z0-9_]*
    ;

ScopeIdToken
    :   [A-Za-z0-9][A-Za-z0-9_]*
    ;

Any : . ;
